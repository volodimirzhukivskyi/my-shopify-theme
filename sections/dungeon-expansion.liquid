{% liquid
  assign feature_blocks = section.blocks | where: 'type', 'feature_card'
  assign heading = section.settings.heading | strip
  assign subtitle = section.settings.subtitle | strip
%}

<section class="dungeon-expansion">
  {% if heading != blank or subtitle != blank %}
    <div class="dungeon-expansion__header">
      {% if heading != blank %}
        <h2 class="dungeon-expansion__title">{{ heading }}</h2>
      {% endif %}

      {% if subtitle != blank %}
        <div class="dungeon-expansion__subtitle">{{ subtitle | escape | newline_to_br }}</div>
      {% endif %}
    </div>
  {% endif %}

  {% if feature_blocks.size > 0 %}
    <div class="dungeon-expansion__cards" aria-label="Dungeon expansion cards">
      {% for block in feature_blocks %}
        {% liquid
          assign card_image = block.settings.image
          assign card_title = block.settings.title | strip
          assign card_link = block.settings.link
          assign button_label = block.settings.button_label | strip
          assign card_modifier = 'dungeon-expansion-card--deep'

          if forloop.first
            assign card_modifier = 'dungeon-expansion-card--featured'
          endif

          if card_title == blank
            assign card_title = 'Featured terrain'
          endif

          if button_label == blank
            assign button_label = 'Discover More'
          endif

          if card_link == blank
            assign card_link = routes.all_products_collection_url
          endif
        %}

        <article class="dungeon-expansion-card {{ card_modifier }}" {{ block.shopify_attributes }}>
          {% if card_image != blank %}
            {{
              card_image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                class: 'dungeon-expansion-card__image',
                widths: '480, 720, 960, 1200, 1600',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: card_title
            }}
          {% else %}
            <div class="dungeon-expansion-card__placeholder" aria-hidden="true">
              {{ 'collection-1' | placeholder_svg_tag: 'dungeon-expansion-card__placeholder-svg' }}
            </div>
          {% endif %}

          <div class="dungeon-expansion-card__shade" aria-hidden="true"></div>

          <div class="dungeon-expansion-card__content">
            <h3 class="dungeon-expansion-card__title">{{ card_title }}</h3>

            <a class="dungeon-expansion-card__link" href="{{ card_link }}">
              <span>{{ button_label }}</span>
              <span class="dungeon-expansion-card__link-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M8.2 5.2 15 12l-6.8 6.8 1.9 1.9 8.7-8.7-8.7-8.7-1.9 1.9Z" />
                </svg>
              </span>
            </a>
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Dungeon expansion",
  "tag": "section",
  "class": "dungeon-expansion-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Expand Your Dungeon"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Add unique characters and interactions to deepen your experience"
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature card",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Featured terrain"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Discover More"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dungeon expansion",
      "category": "Custom",
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "title": "Featured terrain",
            "button_label": "Discover More"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "NPCs & Interactions",
            "button_label": "Discover More"
          }
        }
      ]
    }
  ]
}
{% endschema %}
